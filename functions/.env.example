# Cloud Functions 설정 예시 (비밀 값 아님). 이 파일을 functions/.env 로 복사해 쓴다.
# API 키는 여기에 적지 않는다. Secret Manager에 등록한다:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set LOG_VIEWER_KEY
#   (선택) firebase functions:secrets:set GEMINI_API_KEY

# 기본 공급자: Claude
ENABLE_CLAUDE=true
ANTHROPIC_MODEL=claude-haiku-5-5
# 작업별 예외 모델 ("hint=claude-sonnet-5-5,grade=claude-sonnet-5-5"). 없으면 none
ANTHROPIC_TASK_MODELS=none

# 보조 경로: Gemini 개발자 API (GEMINI_API_KEY 필요)
ENABLE_GEMINI=false
GEMINI_MODEL=gemini-3.5-flash-lite

# 보조 경로: Vertex AI Gemini (함수 서비스 계정 인증, 키 없음)
ENABLE_VERTEX=false
VERTEX_MODEL=gemini-2.5-flash-lite

# Claude 실패(크레딧 소진·장애) 시 대체 경로: OpenAI (OPENAI_API_KEY 필요)
ENABLE_OPENAI=false
OPENAI_MODEL=gpt-6.1-sol
