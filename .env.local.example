# 로컬 개발 전용. 이 파일을 .env.local 로 복사해서 쓴다. 키는 개발 서버(Node) 안에서만 쓰이고 브라우저로 가지 않는다.
# 아무 키도 없으면 Firebase AI Logic(crime-case-file, Gemini)만 쓴다.

# 유료 Claude API (권장: 대화가 가장 안정적이다). 넣으면 /api/ai 프록시가 먼저 쓰인다.
# ANTHROPIC_API_KEY=
# 서버 코드 기본값은 claude-sonnet-5-5. 배포 설정과 같게 하려면 claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5

# 개인 Gemini 키로 프록시를 시험할 때 (Claude 다음 순서로 쓰인다)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# App Check 디버그 토큰 (로컬 개발 전용, VITE_ 접두사 금지: 붙이면 배포 번들에 들어간다). 아무 UUID를 넣고 Firebase 콘솔의 디버그 토큰 관리에 등록한다.
# APPCHECK_DEBUG_TOKEN=

# ── 로그인·결제 (로컬 전용, src/account · dev/billingDev.ts) ──
# 관리자 Google 계정 이메일 (쉼표로 여러 개). /admin 에서 무료 이메일을 정할 수 있다
ADMIN_EMAILS=
# 토스페이먼츠 "API 개별 연동" 테스트 키. 아래는 토스 개발자센터 문서에 공개된 테스트 키다 (실제 돈이 나가지 않는다).
# 내 상점의 테스트 키로 바꾸면 결제 기록이 내 개발자센터에 보인다. 시크릿 키는 서버에서만 쓰인다
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
# 이용권 가격 (원)
PRICE_KRW=9900
# off 로 두면 /api/ai 의 이용권 확인을 끈다 (AI 평가 스크립트 등)
# PAYWALL=off
